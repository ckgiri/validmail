{
  "name": "validmail",
  "version": "1.1.0",
  "description": "Server-side email validation for signups: strict RFC 5321 syntax, disposable-domain blocking and MX checks with A/AAAA fallback, null MX detection, timeouts, caching and an injectable DNS resolver. No SMTP probing. Zero dependencies.",
  "keywords": [
    "email",
    "email-validation",
    "email-validator",
    "validate-email",
    "email-verification",
    "verify-email",
    "mx",
    "mx-record",
    "dns",
    "null-mx",
    "disposable",
    "disposable-email",
    "temporary-email",
    "throwaway",
    "burner",
    "role-account",
    "signup",
    "rfc5321",
    "rfc5322",
    "idn"
  ],
  "license": "MIT",
  "author": "CK Giri <ckgdev@gmail.com>",
  "funding": "https://github.com/ckgiri/validmail?sponsor=1",
  "homepage": "https://github.com/ckgiri/validmail",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ckgiri/validmail.git"
  },
  "bugs": {
    "url": "https://github.com/ckgiri/validmail/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
